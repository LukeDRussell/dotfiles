# https://editorconfig.org: basic formatting, matching what the files use
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 4

[{*.sh,dot_bashrc,dot_bash_profile}]
indent_style = tab

[*.{yml,yaml,lua,toml}]
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false
