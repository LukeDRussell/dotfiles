[user]
	name = Luke D Russell
	email = lukedrussell+git@outlook.com
[credential]
{{- if eq .chezmoi.os "windows" }}
	helper = manager
{{- else if eq .chezmoi.os "darwin" }}
	helper = osxkeychain
{{- else }}
	helper = cache --timeout 86400
{{- end }}
[core]
	excludesfile = ~/.gitignore_global
	editor = nvim
[init]
	defaultBranch = dev
[pull]
	rebase = true
[push]
	default = simple
	autoSetupRemote = true
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[url "https://"]
	insteadOf = git://
