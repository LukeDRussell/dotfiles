[user]
	name = Luke D Russell
	email = lukedrussell+git@outlook.com
[core]
	excludesfile = ~/.gitignore_global
	editor = nvim
[init]
	defaultBranch = dev
[pull]
	rebase = true
[push]
	default = simple
	autoSetupRemote = true
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[url "https://"]
	insteadOf = git://
