# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
	. /etc/bashrc
fi

# User specific environment
# shellcheck disable=SC2076  # literal match is intended (Fedora default)
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
	PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# ble.sh (trial): fish-like autosuggestions, highlighting and a fuller vim
# mode. Settings in ~/.blerc. Start a shell with BLE_DISABLE=1 to skip it.
if [[ $- == *i* && -z ${BLE_DISABLE-} && -f ~/.local/share/blesh/ble.sh ]]; then
	source ~/.local/share/blesh/ble.sh --noattach
fi

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# Enable vim-like; cursor is a line in insert mode and a block in normal mode
if [[ $- == *i* ]]; then
	set -o vi
	# Plain readline only; ble.sh does these in ~/.blerc
	if [[ -z ${BLE_VERSION-} ]]; then
		bind 'set show-mode-in-prompt on'
		bind 'set vi-ins-mode-string \1\e[6 q\2'
		bind 'set vi-cmd-mode-string \1\e[2 q\2'
		# Don't wait 500ms after Esc for a longer key sequence
		bind 'set keyseq-timeout 10'
	fi
fi

# History: large, timestamped, without duplicates or commands starting with a
# space; appended to (not overwritten) when several shells are open
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
HISTTIMEFORMAT='%F %T  '
HISTIGNORE='&:[ ]*:exit:ls:bg:fg:history:clear'
shopt -s histappend cmdhist

# Mostly from bash-sensible (github.com/mrzool/bash-sensible)
if [[ $- == *i* ]]; then
	# Don't let > overwrite an existing file; use >| when you mean it
	set -o noclobber
	# ** matches any depth of folders, e.g. ls **/*.yml
	shopt -s globstar
	# Tab completion: ignore case, treat - and _ alike, list matches on first Tab
	bind 'set completion-ignore-case on'
	bind 'set completion-map-case on'
	bind 'set show-all-if-ambiguous on'
	# Plain readline only; ble.sh binds these in ~/.blerc
	if [[ -z ${BLE_VERSION-} ]]; then
		# Up/Down search history for lines starting with what's already typed
		for keymap in vi-insert vi-command; do
			bind -m "$keymap" '"\e[A": history-search-backward'
			bind -m "$keymap" '"\e[B": history-search-forward'
		done
		unset keymap
		# Space expands !! and !$ on screen before you press Enter
		bind -m vi-insert 'Space: magic-space'
	fi
fi

export EDITOR=nvim
export SUDO_EDITOR=$EDITOR

if command -v nvim >/dev/null 2>&1; then
	alias vi=nvim
	alias vim=nvim
fi

# GNU ls on macOS
if command -v gls >/dev/null 2>&1; then
	alias ls='gls'
fi

# lsd
if command -v lsd >/dev/null 2>&1; then
	alias ls='lsd'
	alias l1='lsd -1'
	alias ll='lsd --long --header --git --classify --group-directories-first'
	alias tree='lsd --tree'
	alias lla='ll --all'
	alias llt='ll --timesort'
	alias lls='ll --sizesort'
else
	alias ll='ls -lh'
	alias lla='ls -lah'
	alias llm='ls -lh --sort=time'
	alias lls='ls -lh --sort=size'
fi

alias df='df -h'
# Create missing parent folders too (and don't complain if it exists)
alias mkdir='mkdir -p'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

alias play='uv run ansible-playbook'
alias tm='tmux new -A -s main'

# Git
alias gitco='git checkout'
alias gita='git add'
alias gitaa='git add .'
alias gitca='git commit -a -m'
alias gits='git status'
alias gitl='git log --oneline --decorate --all --graph'
alias gitp='git pull --rebase'

if command -v zoxide >/dev/null 2>&1; then
	eval "$(zoxide init bash)"
fi

# fzf: Ctrl-R fuzzy history, Ctrl-T insert a file path, Alt-C cd into a folder.
# ble.sh needs its own integration of the same key bindings.
if [[ $- == *i* ]] && command -v fzf >/dev/null 2>&1; then
	if [[ ${BLE_VERSION-} ]]; then
		ble-import -d integration/fzf-completion
		ble-import -d integration/fzf-key-bindings
	else
		eval "$(fzf --bash)"
	fi
fi

# Machine-local additions (work settings, installer PATH lines etc.) go in
# ~/.bashrc.d/; loaded last so they can override anything above
if [ -d ~/.bashrc.d ]; then
	for rc in ~/.bashrc.d/*; do
		if [ -f "$rc" ]; then
			. "$rc"
		fi
	done
fi
unset rc

# Prompt, in the style of Aphrodite (github.com/win0err/aphrodite-terminal-theme)
# plus an OS icon:
#     WSL [venv] user@host:~/dir <branch> 12:34:56
#   $
# The branch is green when clean, yellow with changes; $ turns red after a
# failed command. Icons need a Nerd Font.
if [[ $(uname -r) == *[Mm]icrosoft* ]]; then
	_prompt_os=$' WSL'
elif [[ $(uname -s) == Darwin ]]; then
	_prompt_os=$''
else
	_prompt_os=$''
fi

# Escape characters that PS1 would otherwise expand (a branch named $(cmd))
_prompt_escape() {
	# shellcheck disable=SC1003  # bs is a single backslash, on purpose
	local s=$1 bs='\'
	s=${s//"$bs"/"$bs$bs"}
	s=${s//'$'/"$bs\$"}
	s=${s//'`'/"$bs\`"}
	printf '%s' "$s"
}

_prompt_update() {
	local status=$? line branch git='' venv='' ssh='' char='\[\e[0m\]' dollar='\$'

	# Save each command to the history file straight away, so a closed tmux pane
	# or crashed terminal doesn't lose it
	history -a

	# One git call gives both the branch (first line) and whether anything changed
	if line=$(git --no-optional-locks status --porcelain --branch 2>/dev/null); then
		branch=${line%%$'\n'*}
		branch=${branch#'## '}
		branch=${branch%%...*}
		branch=${branch##* }          # "No commits yet on main" -> main
		[[ $branch == *'(no'* || $branch == 'branch)' ]] && branch=HEAD
		if [[ $line == *$'\n'* ]]; then
			git=" \[\e[93m\]<$(_prompt_escape "$branch")>"
		else
			git=" \[\e[92m\]<$(_prompt_escape "$branch")>"
		fi
	fi
	[[ -n ${VIRTUAL_ENV-} ]] && venv="\[\e[37m\][$(_prompt_escape "${VIRTUAL_ENV##*/}")] "
	[[ -n ${SSH_CONNECTION-} ]] && ssh='\[\e[90m\][\[\e[95m\]ssh\[\e[90m\]]'
	((status)) && char='\[\e[31m\]'

	PS1="\[\e[94m\]${_prompt_os}\[\e[0m\] ${venv}\[\e[36m\]\u\[\e[90m\]@\[\e[94m\]\h${ssh}\[\e[90m\]:\[\e[0m\]\w${git} \[\e[90m\]\t\[\e[0m\]\n${char}${dollar}\[\e[0m\] "
}
# First in PROMPT_COMMAND, so $? is still the last command's status
PROMPT_COMMAND="_prompt_update${PROMPT_COMMAND:+;$PROMPT_COMMAND}"

# ble.sh: attach last, after the prompt and everything else is set up
[[ ! ${BLE_VERSION-} ]] || ble-attach
