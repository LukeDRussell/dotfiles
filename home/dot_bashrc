# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
	. /etc/bashrc
fi

# User specific environment
# shellcheck disable=SC2076  # literal match is intended (Fedora default)
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
	PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# ble.sh (trial): fish-like autosuggestions, highlighting and a fuller vim
# mode. Settings in ~/.blerc. Start a shell with BLE_DISABLE=1 to skip it.
if [[ $- == *i* && -z ${BLE_DISABLE-} && -f ~/.local/share/blesh/ble.sh ]]; then
	source ~/.local/share/blesh/ble.sh --noattach
fi

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# Enable vim-like; cursor is a line in insert mode and a block in normal mode
if [[ $- == *i* ]]; then
	set -o vi
	# Plain readline only; ble.sh does these in ~/.blerc
	if [[ -z ${BLE_VERSION-} ]]; then
		bind 'set show-mode-in-prompt on'
		bind 'set vi-ins-mode-string \1\e[6 q\2'
		bind 'set vi-cmd-mode-string \1\e[2 q\2'
		# Don't wait 500ms after Esc for a longer key sequence
		bind 'set keyseq-timeout 10'
	fi
fi

# History: large, timestamped, without duplicates or commands starting with a
# space; appended to (not overwritten) when several shells are open
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
HISTTIMEFORMAT='%F %T  '
shopt -s histappend cmdhist

export EDITOR=nvim
export SUDO_EDITOR=$EDITOR

if command -v nvim >/dev/null 2>&1; then
	alias vi=nvim
	alias vim=nvim
fi

# GNU ls on macOS
if command -v gls >/dev/null 2>&1; then
	alias ls='gls'
fi

# lsd
if command -v lsd >/dev/null 2>&1; then
	alias ls='lsd'
	alias l1='lsd -1'
	alias ll='lsd --long --header --git --classify --group-directories-first'
	alias tree='lsd --tree'
	alias lla='ll --all'
	alias llt='ll --timesort'
	alias lls='ll --sizesort'
else
	alias ll='ls -lh'
	alias lla='ls -lah'
	alias llm='ls -lh --sort=time'
	alias lls='ls -lh --sort=size'
fi

alias df='df -h'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

alias play='uv run ansible-playbook'
alias tm='tmux new -A -s main'

# Git
alias gitco='git checkout'
alias gita='git add'
alias gitaa='git add .'
alias gitca='git commit -a -m'
alias gits='git status'
alias gitl='git log --oneline --decorate --all --graph'
alias gitp='git pull --rebase'

if command -v zoxide >/dev/null 2>&1; then
	eval "$(zoxide init bash)"
fi

# fzf: Ctrl-R fuzzy history, Ctrl-T insert a file path, Alt-C cd into a folder.
# ble.sh needs its own integration of the same key bindings.
if [[ $- == *i* ]] && command -v fzf >/dev/null 2>&1; then
	if [[ ${BLE_VERSION-} ]]; then
		ble-import -d integration/fzf-completion
		ble-import -d integration/fzf-key-bindings
	else
		eval "$(fzf --bash)"
	fi
fi

# Machine-local additions (work settings, installer PATH lines etc.) go in
# ~/.bashrc.d/; loaded last so they can override anything above
if [ -d ~/.bashrc.d ]; then
	for rc in ~/.bashrc.d/*; do
		if [ -f "$rc" ]; then
			. "$rc"
		fi
	done
fi
unset rc

# Prompt: same oh-my-posh config as pwsh; plain PS1 if it's missing
if command -v oh-my-posh >/dev/null 2>&1; then
	eval "$(oh-my-posh init bash --config ~/.config/oh-my-posh/config.omp.json)"

	# oh-my-posh can't draw its right-hand block (status, git, time) in bash, but
	# ble.sh can: render it with oh-my-posh's own status variables.
	if [[ ${BLE_VERSION-} ]]; then
		# shellcheck disable=SC2154  # _omp_* are set by oh-my-posh before each prompt
		function _omp_get_right {
			local right
			right=$(
				oh-my-posh print right \
					--config ~/.config/oh-my-posh/config.omp.json \
					--shell=bash \
					--shell-version="$BASH_VERSION" \
					--status="$_omp_status" \
					--pipestatus="${_omp_pipestatus[*]}" \
					--no-status="$_omp_no_status" \
					--execution-time="$_omp_execution_time" \
					--terminal-width="${COLUMNS-0}" |
					tr -d '\0'
			)
			printf '%s' "${right@P}"
		}
		# shellcheck disable=SC2016  # run at each prompt, not now
		bleopt prompt_rps1='$(_omp_get_right)'
	fi
else
	# Fallback: user@host:dir, plus the git branch if git's prompt helper exists
	for git_prompt in /usr/share/git-core/contrib/completion/git-prompt.sh \
		/opt/homebrew/etc/bash_completion.d/git-prompt.sh \
		/usr/local/etc/bash_completion.d/git-prompt.sh; do
		if [[ -f $git_prompt ]]; then
			. "$git_prompt"
			break
		fi
	done
	unset git_prompt
	if declare -F __git_ps1 >/dev/null; then
		# Read by __git_ps1
		# shellcheck disable=SC2034
		GIT_PS1_SHOWDIRTYSTATE=1 GIT_PS1_SHOWUNTRACKEDFILES=1
		PS1='\[\e[35m\]\u\[\e[m\]@\[\e[35m\]\h\[\e[m\]:\[\e[32m\]\w\[\e[36m\]$(__git_ps1 " [%s]")\[\e[m\] \$ '
	else
		PS1='\[\e[35m\]\u\[\e[m\]@\[\e[35m\]\h\[\e[m\]:\[\e[32m\]\w\[\e[m\] \$ '
	fi
fi

# ble.sh: attach last, after the prompt and everything else is set up
[[ ! ${BLE_VERSION-} ]] || ble-attach
